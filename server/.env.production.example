# ── SERVER ────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Your real frontend domain (no trailing slash)
CLIENT_URL=https://shahiscoops.com

# ── DATABASE ─────────────────────────────────────────────
# Production: PostgreSQL recommended. See docs/MIGRATION.md.
# SQLite is fine for low-traffic single-server deployments.
DB_TYPE=sqlite
DB_FILE=./data/shahi_scoops.db

# ── JWT SECRETS (REQUIRED) ───────────────────────────────
# Generate fresh: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# NEVER reuse dev secrets. NEVER commit real secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── SECURITY ─────────────────────────────────────────────
COOKIE_SECURE=1
CORS_ORIGINS=https://shahiscoops.com,https://www.shahiscoops.com

# ── RATE LIMITS ──────────────────────────────────────────
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000

# ── EMAIL (REQUIRED for password reset, welcome, etc.) ───
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Shahi Scoops <orders@shahiscoops.com>"

# ── RAZORPAY (REQUIRED for payments) ──────────────────────
# Use LIVE keys after KYC approval
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OBSERVABILITY (optional but recommended) ─────────────
SENTRY_DSN=
LOG_LEVEL=info
