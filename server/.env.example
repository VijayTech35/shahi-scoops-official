# ── SERVER ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── DATABASE ─────────────────────────────────────────────
# SQLite: zero-setup, file-based. Just leave as-is.
# To use MySQL later, set DB_TYPE=mysql and the values below.
DB_TYPE=sqlite
DB_FILE=./data/shahi_scoops.db

# ── JWT SECRETS (use long random strings in production) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=shahi_access_secret_replace_with_64char_random_string
JWT_REFRESH_SECRET=shahi_refresh_secret_replace_with_64char_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── SECURITY ─────────────────────────────────────────────
# Set to 1 in production (behind HTTPS-terminating proxy)
COOKIE_SECURE=0
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── RATE LIMITS (per IP) ─────────────────────────────────
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000

# ── EMAIL (Gmail SMTP) ────────────────────────────────────
# Use Gmail App Password (not your regular password)
# Go to: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="Shahi Scoops <orders@shahiscoops.com>"

# ── RAZORPAY ──────────────────────────────────────────────
# Use test keys during development, live keys after KYC approval
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── OBSERVABILITY (optional) ──────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
